---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <img src={`${base}/images/logo.webp`} alt="Victory Social Club" />
      <p class="tag">Sports · Restaurant · Community</p>
    </div>
    <div class="foot-col">
      <span class="eyebrow">Find Us</span>
      <p>3707 1st Avenue SE<br />Cedar Rapids, IA 52402</p>
      <a href="tel:+13194036064">(319) 403-6064</a>
    </div>
    <div class="foot-col">
      <span class="eyebrow">Follow</span>
      <a href="https://www.instagram.com/_victorysocialclub" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.facebook.com/61590946788004" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <div class="wrap foot-base">
    <span>© {year} Victory Social Club</span>
    <span>Cedar Rapids, Iowa</span>
  </div>
</footer>
<style>
  .foot { background: var(--char); border-top: 1px solid var(--line); padding: 4rem 0 2rem; }
  .foot-inner { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2.5rem; }
  .foot-brand img { height: 64px; margin-bottom: 1rem; }
  .tag { font-family: var(--font-display); font-style: italic; color: var(--bronze); font-size: 1.05rem; }
  .foot-col { display: flex; flex-direction: column; gap: 0.5rem; }
  .foot-col .eyebrow { margin-bottom: 0.6rem; }
  .foot-col a, .foot-col p { color: var(--cream-dim); font-size: 0.92rem; }
  .foot-col a:hover { color: var(--bronze); }
  .foot-base {
    display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1.5rem;
    border-top: 1px solid var(--line); font-size: 0.72rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--cream-dim);
  }
  @media (max-width: 680px) {
    .foot-inner { grid-template-columns: 1fr; gap: 2rem; }
    .foot-base { flex-direction: column; gap: 0.5rem; text-align: center; }
  }
</style>
