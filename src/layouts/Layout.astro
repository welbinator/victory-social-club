---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = "Victory Social Club — a refined social house in Cedar Rapids for craft cocktails, chef-driven plates, and good company." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// noindex only on the GitHub Pages staging build (which sets a non-empty base path).
// Production (Cloudflare Pages, base === '') stays indexable.
const isStaging = base !== '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/webp" href={`${base}/images/logo.webp`} />
    <title>{title}</title>
    <script is:inline>
      // no-flash: apply saved theme before paint
      (function () {
        try {
          if (localStorage.getItem('vsc-theme') === 'light')
            document.documentElement.classList.add('light');
        } catch (e) {}
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --near-black: #090909;
        --char: #121212;
        --panel: #1a1a1a;
        --copper: #b5652e;
        --bronze: #dca05c;
        --ember: #a83000;
        --cream: #f2ece1;
        --cream-dim: #c8bfb1;
        --line: #3a2f26;
        --nav-bg: rgba(9, 9, 9, 0.82);
        --font-display: "Cormorant Garamond", Georgia, serif;
        --font-body: "Jost", system-ui, sans-serif;
        --radius: 5px;
      }
      html.light {
        --near-black: #faf7f2;
        --char: #f0ebe2;
        --panel: #e7e0d4;
        --cream: #1c1712;
        --cream-dim: #5f564a;
        --line: #ddd3c4;
        --bronze: #9a6a24;
        --nav-bg: rgba(250, 247, 242, 0.85);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--near-black);
        color: var(--cream);
        font-family: var(--font-body);
        font-weight: 300;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 500; line-height: 1.1; letter-spacing: 0.01em; }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      .wrap { width: min(1120px, 92vw); margin: 0 auto; }
      .eyebrow {
        font-family: var(--font-body); font-size: 0.72rem; font-weight: 400;
        letter-spacing: 0.32em; text-transform: uppercase; color: var(--bronze);
      }
      .btn {
        display: inline-block; font-family: var(--font-body); font-size: 0.78rem;
        letter-spacing: 0.22em; text-transform: uppercase; padding: 0.95rem 2rem;
        border: 1px solid var(--copper); color: var(--cream); border-radius: var(--radius);
        transition: background .3s ease, color .3s ease;
      }
      .btn:hover { background: var(--copper); color: #fff; }
      .btn-solid { background: var(--copper); color: #fff; border-color: var(--copper); }
      .btn-solid:hover { background: var(--bronze); border-color: var(--bronze); color: #fff; }
      .rule { width: 54px; height: 1px; background: var(--copper); border: 0; }
      /* scroll reveal — fails OPEN */
      .rise { transition: opacity .8s ease, transform .8s ease; }
      html.js .rise { opacity: 0; transform: translateY(20px); }
      html.js .rise.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        html.js .rise, .rise { opacity: 1; transform: none; transition: none; }
      }
      section { padding: clamp(4rem, 9vw, 7.5rem) 0; }

      /* Hero sits over a dark photo — keep its text light in BOTH themes */
      html.light .hero .eyebrow { color: var(--bronze); }
      html.light .hero h1 { color: #f2ece1; }
      html.light .hero .hero-sub { color: #d8cfc0; }
      html.light .hero .btn { color: #f2ece1; border-color: var(--copper); }
      html.light .hero .btn:hover { color: #fff; }
      html.light .marquee { color: #1c1712; }

      /* Theme toggle button */
      .theme-toggle {
        background: none; border: 1px solid var(--line); border-radius: var(--radius);
        color: var(--cream-dim); cursor: pointer; font-family: var(--font-body);
        font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
        padding: 0.5rem 0.85rem; display: inline-flex; align-items: center; gap: 0.4rem;
        transition: color .25s ease, border-color .25s ease;
      }
      .theme-toggle:hover { color: var(--copper); border-color: var(--copper); }
    </style>
  </head>
  <body>
    <slot />
    <script>
      document.documentElement.classList.add('js');
      const risers = [...document.querySelectorAll('.rise')];
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      risers.forEach((el) => io.observe(el));
      setTimeout(() => risers.forEach((el) => el.classList.add('in')), 2500);
    </script>
  </body>
</html>
